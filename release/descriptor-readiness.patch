@@ -0,0 +1,106 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"time"
+)
+
+type readinessProof struct {
+	InitialHTTPStatus   int    `json:"initial_http_status"`
+	FullHTTPStatus      int    `json:"full_http_status"`
+	FullReason          string `json:"full_reason"`
+	RecoveredHTTPStatus int    `json:"recovered_http_status"`
+	RecoveredReason     string `json:"recovered_reason"`
+}
+
+type readyResponse struct {
+	status int
+	Ready  *bool  `json:"ready"`
+	Reason string `json:"reason"`
+}
+
+func readReady(ctx context.Context, s *server) (got readyResponse, err error) {
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, "http://"+s.addr+"/ready", nil)
+	if err != nil {
+		return got, err
+	}
+	res, err := s.client.Do(req)
+	if err != nil {
+		return got, err
+	}
+	defer func() { err = errors.Join(err, res.Body.Close()) }()
+	got.status = res.StatusCode
+	if got.status == http.StatusNotFound {
+		return got, nil
+	}
+	const maxBody = 1024
+	body, err := io.ReadAll(io.LimitReader(res.Body, maxBody+1))
+	if err != nil {
+		return got, err
+	}
+	if len(body) > maxBody || res.Header.Get("Cache-Control") != "no-store" {
+		return got, errors.New("GET /ready: expected bounded, uncached response")
+	}
+	if err := json.Unmarshal(body, &got); err != nil || got.Ready == nil {
+		return got, fmt.Errorf("invalid readiness response %.200q: %v", body, err)
+	}
+	return got, nil
+}
+
+func waitReadyState(ctx context.Context, s *server, status int, reason string, allowMissing bool) (readyResponse, error) {
+	ctx, cancel := context.WithTimeout(ctx, 7*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(50 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		got, err := readReady(ctx, s)
+		if err != nil {
+			return got, err
+		}
+		if (allowMissing && got.status == http.StatusNotFound) ||
+			(got.status == status && got.Reason == reason && *got.Ready == (status == http.StatusOK)) {
+			return got, nil
+		}
+		select {
+		case <-ctx.Done():
+			return got, fmt.Errorf("GET /ready: want %d %s, last response %d %s: %w", status, reason, got.status, got.Reason, ctx.Err())
+		case <-ticker.C:
+		}
+	}
+}
+
+func probeDescriptorReadiness(ctx context.Context, s *server, filler string) (proof readinessProof, err error) {
+	initial, err := waitReadyState(ctx, s, http.StatusOK, "ready", true)
+	proof.InitialHTTPStatus = initial.status
+	if err != nil || initial.status == http.StatusNotFound {
+		return proof, err
+	}
+
+	// Rename within the existing private mount. The original data path is
+	// absent while two opposite headroom states are observed through /ready.
+	moved := s.dir + ".pinned"
+	if err := os.Rename(s.dir, moved); err != nil {
+		return proof, err
+	}
+	defer func() { err = errors.Join(err, os.Rename(moved, s.dir)) }()
+	if err := fillFilesystem(filler); err != nil {
+		return proof, err
+	}
+	full, err := waitReadyState(ctx, s, http.StatusServiceUnavailable, "low_disk_headroom", false)
+	proof.FullHTTPStatus, proof.FullReason = full.status, full.Reason
+	if err != nil {
+		return proof, err
+	}
+	if err := os.Remove(filler); err != nil {
+		return proof, err
+	}
+	recovered, err := waitReadyState(ctx, s, http.StatusOK, "ready", false)
+	proof.RecoveredHTTPStatus, proof.RecoveredReason = recovered.status, recovered.Reason
+	return proof, err
+}
