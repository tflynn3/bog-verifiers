+func TestValidatePostRestoreAckCrashEvidence(t *testing.T) {
+	id := identity{1, testRevision, strings.Repeat("a", 64), capacityFixtureID}
+	proof := postRestoreAckCrashJSON
+	required := []string{restoredParityCase, ordinaryWALCase, postRestoreAckCrashCase}
+	for _, tc := range []struct {
+		name, status, evidence string
+		pass                   bool
+	}{
+		{"valid", "pass", proof, true},
+		{"historical", "", "", false},
+		{"skip", "skip", proof, false},
+		{"string signal", "pass", strings.Replace(proof, `"observed_signal":9`, `"observed_signal":"9"`, 1), false},
+		{"no committed suffix", "pass", strings.Replace(proof, `"CommittedEnd":200`, `"CommittedEnd":100`, 1), false},
+		{"unmatched replay", "pass", strings.Replace(proof, `"replay_matched":true`, `"replay_matched":false`, 1), false},
+		{"missing cleanup", "pass", strings.Replace(proof, `,"fixture_removed":true`, "", 1), false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cases := map[string]outcome{
+				ordinaryWALCase:    {Status: "pass", Evidence: jsontext.Value(ordinaryWALJSON)},
+				restoredParityCase: {Status: "pass", Evidence: jsontext.Value(restoredParityJSON)},
+			}
+			if tc.status != "" {
+				cases[postRestoreAckCrashCase] = outcome{Status: tc.status, Evidence: jsontext.Value(tc.evidence)}
+			}
+			raw, err := json.Marshal(report{id, cases})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if err := validateReportWithOptions(raw, id, required, validationOptions{requireCutover: true}); (err == nil) != tc.pass {
+				t.Fatalf("cutover validation = %v, want pass %t", err, tc.pass)
+			}
+			if tc.status == "" {
+				if err := validateReport(raw, id, []string{restoredParityCase}); err != nil {
+					t.Fatalf("historical validation: %v", err)
+				}
+			}
+		})
+	}
+}
