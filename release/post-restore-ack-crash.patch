+func validatePostRestoreAckCrash(raw jsontext.Value) error {
+	var point jsontext.Value
+	var status, observedSignal, rows int
+	var matched, crashReaped, restartReaped, removed bool
+	if _, err := decodeFields(raw, map[string]any{
+		"verified_point": &point, "append_status": &status, "observed_signal": &observedSignal,
+		"replay_matched": &matched, "replay_rows": &rows, "crash_candidate_reaped": &crashReaped,
+		"restart_candidate_reaped": &restartReaped, "fixture_removed": &removed,
+	}); err != nil {
+		return fmt.Errorf("evidence: %w", err)
+	}
+	var generation []*uint8
+	var covered, committed, next int64
+	if _, err := decodeFields(point, map[string]any{
+		"Generation": &generation, "CoveredOffset": &covered, "CommittedEnd": &committed, "NextOrdinal": &next,
+	}); err != nil {
+		return fmt.Errorf("verified point: %w", err)
+	}
+	if len(generation) != 32 || covered <= 0 || committed <= covered || next != paritySeedRows {
+		return fmt.Errorf("verified point: require a checkpoint at ordinal %d and a committed WAL suffix", paritySeedRows)
+	}
+	nonzero := false
+	for _, b := range generation {
+		if b == nil {
+			return fmt.Errorf("verified point: null generation byte")
+		}
+		nonzero = nonzero || *b != 0
+	}
+	if !nonzero {
+		return fmt.Errorf("verified point: empty checkpoint generation")
+	}
+	if status != http.StatusNoContent || observedSignal != int(syscall.SIGKILL) {
+		return fmt.Errorf("require immediate HTTP 204 and observed SIGKILL, got status=%d signal=%d", status, observedSignal)
+	}
+	if !matched || rows != postRestoreCrashRows {
+		return fmt.Errorf("require exact replay of %d rows, got matched=%t rows=%d", postRestoreCrashRows, matched, rows)
+	}
+	if !crashReaped || !restartReaped || !removed {
+		return fmt.Errorf("require reaping and fixture removal, got crash_reaped=%t restart_reaped=%t fixture_removed=%t", crashReaped, restartReaped, removed)
+	}
+	return nil
+}
