+
+func probeOperator(ctx context.Context, operator, bundle, base string, rows int) (*operatorProof, error) {
+	proof := &operatorProof{}
+	help, err := exec.CommandContext(ctx, operator, "compare", "-help").CombinedOutput()
+	if err != nil {
+		return proof, fmt.Errorf("compare help: %w: %s", err, help)
+	}
+	proof.PageCeiling = slices.Contains(strings.Fields(strings.NewReplacer("[", " ", "]", " ", "=", " ").Replace(string(help))), "-max-pages")
+	args := []string{"compare", "-backup", bundle, "-url", base, "-start", fixtureStart,
+		"-end", fixtureEnd, "-limit", "1", "-timeout", "5s"}
+	match := fmt.Sprintf("query matched: rows=%d reference_pages=%d server_pages=%d ", rows, rows, rows)
+	for _, ceiling := range []string{"", fmt.Sprint(rows)} {
+		command := slices.Clone(args)
+		if ceiling != "" {
+			if !proof.PageCeiling {
+				return proof, nil
+			}
+			command = append(command, "-max-pages", ceiling)
+		}
+		out, err := exec.CommandContext(ctx, operator, command...).CombinedOutput()
+		if err != nil || !strings.HasPrefix(string(out), match) {
+			return proof, fmt.Errorf("compare max-pages %q: %v: %s", ceiling, err, out)
+		}
+		if ceiling == "" {
+			proof.DefaultRows = rows
+		} else {
+			proof.BoundedRows = rows
+		}
+	}
+	out, err := exec.CommandContext(ctx, operator, append(args, "-max-pages", "1")...).CombinedOutput()
+	var exit *exec.ExitError
+	if !errors.As(err, &exit) || exit.ExitCode() != 4 || strings.Contains(string(out), "query matched:") ||
+		!strings.Contains(string(out), "walk at row 2") || !strings.Contains(string(out), "query page budget exhausted") {
+		return proof, fmt.Errorf("compare max-pages 1: expected incomplete comparison at row 2: %v: %s", err, out)
+	}
+	proof.LowCapExit = exit.ExitCode()
+	return proof, nil
+}
