+func checkRestoredResume(ctx context.Context, pager *releasePager, cursor string, want []row) (int64, error) {
+	page, framed, err := pager.fetch(ctx, "", 1, cursor)
+	if err != nil {
+		return 0, err
+	}
+	if len(page.Rows) != 1 || page.NextCursor == "" || framed.ContentLength <= 0 ||
+		framed.ContentLength > restoredPageCap {
+		return 0, errors.New("expected one framed row and a continuation from the restore capture")
+	}
+	return framed.ContentLength, checkPageRows(page.Rows, want[:1])
+}
