+func parityRowsFor(appendOrder []row, filter string) ([]row, error) {
+	start, err := time.Parse(time.RFC3339Nano, fixtureStart)
+	if err != nil {
+		return nil, err
+	}
+	end, err := time.Parse(time.RFC3339Nano, fixtureEnd)
+	if err != nil {
+		return nil, err
+	}
+	var log querymodel.Log
+	batch := make([]querymodel.Row, 0, len(appendOrder))
+	for _, r := range appendOrder {
+		ts, err := time.Parse(time.RFC3339Nano, r.TS)
+		if err != nil {
+			return nil, err
+		}
+		batch = append(batch, querymodel.Row{Time: ts, Line: r.Line})
+	}
+	entries, err := log.Match(log.Append(batch), querymodel.Filter{Start: start, End: end, Contains: filter})
+	if err != nil {
+		return nil, err
+	}
+	want := make([]row, 0, len(entries))
+	for _, entry := range entries {
+		want = append(want, row{entry.Time.Format(time.RFC3339Nano), entry.Line})
+	}
+	return want, nil
+}
+
+func checkUnpaged(ctx context.Context, client *http.Client, base string, rows []row) error {
+	want, err := parityRowsFor(rows, "")
+	if err != nil {
+		return err
+	}
+	// The response byte cap can trim the ordinary prefix. Its first two
+	// rows fit, so compare that exact prefix and require no cursor.
+	path := strings.Replace(queryPath("", 2, ""), "&page=1", "", 1)
+	res, err := request(ctx, client, http.MethodGet, base+path, nil)
+	if err != nil {
+		return err
+	}
+	n, err := checkRows(res, want[:2])
+	if err != nil || n != 2 || res.cursorHeader || !res.framed || !bytes.HasSuffix(res.body, []byte("\n")) {
+		return fmt.Errorf("expected two framed unpaged rows without a cursor: HTTP %d, rows %d, error %v", res.status, n, err)
+	}
+	return nil
+}
