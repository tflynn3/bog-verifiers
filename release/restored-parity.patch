+func requireReplayedRestore(ctx context.Context, pager *releasePager, cursor string, want []row, firstBytes int64) error {
+	page, framed, err := pager.fetch(ctx, "", 1, cursor)
+	if err != nil {
+		return err
+	}
+	if len(page.Rows) != 1 || page.NextCursor == "" || framed.ContentLength != firstBytes {
+		return errors.New("replayed restore continuation changed framing or exhaustion")
+	}
+	if err := checkPageRows(page.Rows, want[:1]); err != nil {
+		return err
+	}
+	return resumeRestoredWalk(ctx, pager, "", 1, want[1:], page.NextCursor)
