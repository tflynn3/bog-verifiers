+type operatorProof struct {
+	DefaultRows int  `json:"default_rows"`
+	PageCeiling bool `json:"page_ceiling_advertised"`
+	BoundedRows int  `json:"bounded_rows,omitempty"`
+	LowCapExit  int  `json:"low_cap_exit,omitempty"`
