diff --git a/verify/release/replacement_linux_test.go b/verify/release/replacement_linux_test.go
new file mode 100644
index 0000000..6282dc0
--- /dev/null
+++ b/verify/release/replacement_linux_test.go
@@ -0,0 +1,177 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"os/exec"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+)
+
+const replacementFlag = "-enable-capacity-control"
+
+type replacementState struct {
+	State         string `json:"state"`
+	Generation    uint64 `json:"generation"`
+	CoveredRows   int    `json:"covered_rows"`
+	CommittedRows int    `json:"committed_rows"`
+}
+
+type replacementProof struct {
+	Status           string           `json:"status"`
+	Detail           string           `json:"detail,omitempty"`
+	Initial          replacementState `json:"initial"`
+	Published        replacementState `json:"published"`
+	AppendHTTPStatus int              `json:"append_http_status"`
+	SnapshotRows     int              `json:"snapshot_rows"`
+	FreshRows        int              `json:"fresh_rows"`
+	RestartRows      int              `json:"restart_rows"`
+}
+
+func advertisesFlag(ctx context.Context, binary, flag string) (bool, error) {
+	help, err := exec.CommandContext(ctx, binary, "-help").CombinedOutput()
+	if err != nil {
+		return false, fmt.Errorf("probe %s: %w: %.200s", flag, err, help)
+	}
+	for line := range strings.SplitSeq(string(help), "\n") {
+		fields := strings.Fields(line)
+		if len(fields) > 0 {
+			name, _, _ := strings.Cut(fields[0], "=")
+			if name == flag {
+				return true, nil
+			}
+		}
+	}
+	return false, nil
+}
+
+func probeReplacement(ctx context.Context, binary, dir string, client *http.Client, flags []string, rows []row) (proof *replacementProof, err error) {
+	proof = &replacementProof{Status: "fail"}
+	defer func() {
+		if err != nil {
+			proof.Detail = err.Error()
+		}
+	}()
+	enabled, err := advertisesFlag(ctx, binary, replacementFlag)
+	if err != nil {
+		return proof, err
+	}
+	if !enabled {
+		proof.Status, proof.Detail = "skip", "candidate does not advertise "+replacementFlag
+		return proof, nil
+	}
+	want, err := parityRowsFor(rows, "")
+	if err != nil {
+		return proof, err
+	}
+	backfill := []row{{want[0].TS, "replacement backfill [match]"}, {rows[1].TS, "replacement tie [match]"}}
+	augmented := append(slices.Clone(rows), backfill...)
+	initialCutoff := len(rows)
+	cutoff := len(augmented)
+	err = serveDirectory(ctx, binary, dir, client, append(slices.Clone(flags), replacementFlag), func(base string) error {
+		if proof.Initial, err = readReplacement(ctx, client, base, http.MethodGet, "status", 0); err != nil {
+			return err
+		}
+		if proof.Initial.CommittedRows != initialCutoff || proof.Initial.CoveredRows > initialCutoff {
+			return fmt.Errorf("unexpected initial restored compaction state: %+v", proof.Initial)
+		}
+
+		pager, err := newReleasePager(base, client, restoredPageCap)
+		if err != nil {
+			return err
+		}
+		first, _, err := pager.fetch(ctx, "", 1, "")
+		if err != nil {
+			return fmt.Errorf("open restored snapshot: %w", err)
+		}
+		if len(first.Rows) != 1 || first.NextCursor == "" {
+			return fmt.Errorf("expected one restored row and a cursor before replacement")
+		}
+		if err := checkPageRows(first.Rows, want[:1]); err != nil {
+			return err
+		}
+		proof.AppendHTTPStatus, err = ingest(ctx, client, base, backfill)
+		if err != nil {
+			return err
+		}
+		if _, err := readReplacement(ctx, client, base, http.MethodPost, "start", cutoff); err != nil {
+			return err
+		}
+		wait, cancel := context.WithTimeout(ctx, 10*time.Second)
+		defer cancel()
+		ticker := time.NewTicker(20 * time.Millisecond)
+		defer ticker.Stop()
+		for {
+			proof.Published, err = readReplacement(wait, client, base, http.MethodGet, "status", cutoff)
+			if err != nil {
+				return err
+			}
+			if proof.Published.State == "complete" && proof.Published.Generation > proof.Initial.Generation {
+				break
+			}
+			select {
+			case <-wait.Done():
+				return fmt.Errorf("wait for restored generation replacement: %w", wait.Err())
+			case <-ticker.C:
+			}
+		}
+		if proof.Published.CoveredRows != cutoff || proof.Published.CommittedRows != cutoff {
+			return fmt.Errorf("unexpected restored compaction cutoff: %+v", proof.Published)
+		}
+		if err := resumeRestoredWalk(ctx, pager, "", 2, want[1:], first.NextCursor); err != nil {
+			return fmt.Errorf("resume restored snapshot after replacement: %w", err)
+		}
+		proof.SnapshotRows = len(want)
+		if err := checkUnpaged(ctx, client, base, augmented); err != nil {
+			return err
+		}
+		if err := checkRestoredWalks(ctx, pager, augmented); err != nil {
+			return fmt.Errorf("fresh walk after replacement: %w", err)
+		}
+		proof.FreshRows = cutoff
+		return nil
+	})
+	if err != nil {
+		return proof, err
+	}
+	err = serveDirectory(ctx, binary, dir, client, flags, func(base string) error {
+		pager, err := newReleasePager(base, client, restoredPageCap)
+		if err != nil {
+			return err
+		}
+		if err := checkUnpaged(ctx, client, base, augmented); err != nil {
+			return err
+		}
+		if err := checkRestoredWalks(ctx, pager, augmented); err != nil {
+			return fmt.Errorf("restart after replacement: %w", err)
+		}
+		proof.RestartRows = cutoff
+		return nil
+	})
+	if err == nil {
+		proof.Status = "pass"
+	}
+	return proof, err
+}
+
+func readReplacement(ctx context.Context, client *http.Client, base, method, action string, cutoff int) (replacementState, error) {
+	var state replacementState
+	res, err := request(ctx, client, method, base+"/_capacity/compaction?action="+action+"&cutoff="+strconv.Itoa(cutoff), nil)
+	if err != nil {
+		return state, fmt.Errorf("restored compaction %s: %w", action, err)
+	}
+	if res.status < 200 || res.status >= 300 {
+		return state, fmt.Errorf("restored compaction %s: HTTP %d: %.200q", action, res.status, res.body)
+	}
+	if err := json.Unmarshal(res.body, &state); err != nil {
+		return state, fmt.Errorf("decode restored compaction %s: %w", action, err)
+	}
+	if state.State != "running" && state.State != "complete" || state.CoveredRows < 0 {
+		return state, fmt.Errorf("invalid restored compaction %s state: %+v", action, state)
+	}
+	return state, nil
+}
