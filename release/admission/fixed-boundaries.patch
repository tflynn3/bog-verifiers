+func TestBudgetWalkAcknowledgedBackfill(t *testing.T) {
+	t.Parallel()
+	const (
+		budget     = 314
+		firstToken = "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
+		nextToken  = "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB"
+	)
+	tie := row{fixtureStart, "@tied"}
+	last := row{fixtureStart, "@last"}
+	want := []row{last, tie, tie, last}
+	backfill := []row{{fixtureStart, "@new"}, tie}
+	fixture := budgetFixture{
+		seed: want, want: want, afterIssue: backfill,
+		firstLimit: 4, firstRows: 2, resumeLimit: 1, byteCap: 96,
+	}
+	for _, tc := range []struct {
+		name        string
+		stopAt      int
+		outcome     budgetProbeOutcome
+		pages, rows int
+		acks        int
+		brokenPage  int
+	}{
+		{"exhausts with both original duplicates", 6, probeExhausted, 3, 4, 2, 0},
+		{"rejects before cursor", 2, probeRejected, 0, 0, 0, 0},
+		{"rejects issued cursor", 4, probeIssued, 1, 2, 1, 2},
+		{"backfill fails after second page", 5, probeIssued, 2, 3, 1, 0},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			t.Parallel()
+			var requests atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, req *http.Request) {
+				step := int(requests.Add(1))
+				switch step {
+				case 1, 3, 5:
+					var expected strings.Builder
+					enc := json.NewEncoder(&expected)
+					rows := fixture.seed
+					if step > 1 {
+						rows = backfill[(step-3)/2 : (step-3)/2+1]
+					}
+					for _, r := range rows {
+						if err := enc.Encode(r); err != nil {
+							t.Error(err)
+						}
+					}
+					body, err := io.ReadAll(req.Body)
+					if err != nil || req.Method != http.MethodPost || req.URL.Path != "/ingest" || string(body) != expected.String() {
+						t.Errorf("step %d: unexpected ingest %s %s: %q (%v)", step, req.Method, req.URL, body, err)
+					}
+					if step == 5 && tc.stopAt == 5 {
+						http.Error(w, "write failed", http.StatusInternalServerError)
+						return
+					}
+					w.WriteHeader(http.StatusNoContent)
+				case 2, 4, 6:
+					q := req.URL.Query()
+					cursor, limit := "", "4"
+					page, next := want[:2], firstToken
+					if step == 4 {
+						cursor, limit, page, next = firstToken, "1", want[2:3], nextToken
+					}
+					if step == 6 {
+						cursor, limit, page, next = nextToken, "1", want[3:], ""
+					}
+					if req.Method != http.MethodGet || req.URL.Path != "/query" || q.Get("limit") != limit ||
+						q.Get("cursor") != cursor || (q.Get("page") == "1") != (step == 2) {
+						t.Errorf("step %d: unexpected query %s %s", step, req.Method, req.URL)
+					}
+					if step == tc.stopAt && (step == 2 || step == 4) {
+						http.Error(w, strings.TrimSuffix(budgetRejectionBody, "\n"), http.StatusServiceUnavailable)
+						return
+					}
+					w.Header().Set("Content-Type", "application/x-ndjson")
+					if next != "" {
+						w.Header().Set(nextCursor, next)
+					}
+					for _, r := range page {
+						if err := json.NewEncoder(w).Encode(r); err != nil {
+							t.Error(err)
+						}
+					}
+				default:
+					t.Errorf("unexpected request %s %s", req.Method, req.URL)
+					w.WriteHeader(http.StatusInternalServerError)
+				}
+			}))
+			defer srv.Close()
+			probe, err := runBudgetWalk(t.Context(), srv.Client(), srv.URL, budget, fixture)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if probe.Outcome != tc.outcome || probe.Pages != tc.pages || probe.Rows != tc.rows ||
+				probe.ResumeLimit != 1 || probe.AppendedRows != tc.acks || len(probe.BackfillAcks) != tc.acks ||
+				int(requests.Load()) != tc.stopAt {
+				t.Fatalf("unexpected evidence: %+v, requests=%d", probe, requests.Load())
+			}
+			for i, ack := range probe.BackfillAcks {
+				if ack.AfterPage != i+1 || ack.HTTPStatus != http.StatusNoContent {
+					t.Errorf("unexpected acknowledgement: %+v", ack)
+				}
+			}
+			var search budgetSearch
+			search.record(probe)
+			if tc.brokenPage != 0 {
+				failure := search.stats.FirstBrokenContinuation
+				if failure == nil || failure.Page != tc.brokenPage || failure.Budget != budget ||
+					failure.Limit != 1 || failure.HTTPStatus != http.StatusServiceUnavailable {
+					t.Errorf("unexpected continuation failure: %+v", failure)
+				}
+			} else if search.stats.FirstBrokenContinuation != nil {
+				t.Errorf("unexpected broken continuation: %+v", search.stats.FirstBrokenContinuation)
+			}
+			if tc.stopAt == 5 {
+				if probe.Failure == nil || probe.Failure.Stage != "backfill" || probe.Failure.Page != 2 ||
+					probe.Failure.HTTPStatus != http.StatusInternalServerError {
+					t.Errorf("unexpected backfill failure: %+v", probe.Failure)
+				}
+			} else if tc.brokenPage == 0 && probe.Failure != nil {
+				t.Errorf("unexpected failure: %+v", probe.Failure)
+			}
+		})
+	}
+}
