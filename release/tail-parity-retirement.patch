+// Correlate the control response with the selected predecessor tail observed
+// through the pinned directory, then require that exact inode to be unlinked.
+func verifyTailParityReclamation(ctx context.Context, client *http.Client, base string, data *os.Root,
+	cursor string, authority tailParityAuthority, predecessor, published backfillCompaction,
+) error {
+	const control = "/_capacity/compaction?action="
+	observe := func(ctx context.Context) (capacityevidence.RuntimeMetrics, error) {
+		var wire struct {
+			State      string          `json:"state"`
+			Generation uint64          `json:"generation"`
+			Covered    int             `json:"covered_rows"`
+			Committed  int             `json:"committed_rows"`
+			Metrics    json.RawMessage `json:"metrics"`
+		}
+		target := fmt.Sprintf("%s%sstatus&cutoff=%d", base, control, published.covered)
+		res, err := request(ctx, client, http.MethodGet, target, nil)
+		if err != nil {
+			return capacityevidence.RuntimeMetrics{}, err
+		}
+		if res.status != http.StatusOK {
+			return capacityevidence.RuntimeMetrics{}, fmt.Errorf("pin status returned HTTP %d", res.status)
+		}
+		if err := json.Unmarshal(res.body, &wire); err != nil {
+			return capacityevidence.RuntimeMetrics{}, err
+		}
+		if (backfillCompaction{wire.State, wire.Generation, wire.Covered, wire.Committed}) != published {
+			return capacityevidence.RuntimeMetrics{}, errors.New("pin observation changed the published replacement")
+		}
+		metrics, _, err := capacityevidence.DecodeRuntimeMetrics(wire.Metrics)
+		return metrics, err
+	}
+	metrics, err := observe(ctx)
+	if err != nil {
+		return fmt.Errorf("observe terminal predecessor pin: %w", err)
+	}
+	credited, err := metrics.Reclamation(predecessor.generation, published.generation)
+	if err != nil {
+		return err
+	}
+	if metrics.RetiredPins == nil || *metrics.RetiredPins == 0 ||
+		metrics.PredecessorPinGeneration == nil || *metrics.PredecessorPinGeneration != predecessor.generation || credited != nil {
+		return fmt.Errorf("expected predecessor generation %d pinned after terminal retry, before reclamation", predecessor.generation)
+	}
+	file, info, err := openTailArtifact(data, authority.Tail, tailParityByteLimit)
+	if err != nil {
+		return fmt.Errorf("open pinned predecessor tail: %w", err)
+	}
+	defer file.Close()
+	stat, ok := info.Sys().(*syscall.Stat_t)
+	if !ok || uint64(stat.Dev) != authority.TailDevice || uint64(stat.Ino) != authority.TailInode || stat.Nlink != 1 {
+		return errors.New("pinned predecessor tail does not match the selector or has unexpected links")
+	}
+
+	res, err := request(ctx, client, http.MethodPost, base+control+"retire&cursor="+url.QueryEscape(cursor), nil)
+	if err != nil {
+		return err
+	}
+	if res.status != http.StatusNoContent || len(res.body) != 0 {
+		return fmt.Errorf("terminal capture retirement returned HTTP %d with %d bytes, want empty 204", res.status, len(res.body))
+	}
+	drain, cancel := context.WithTimeout(ctx, 5*time.Second)
+	defer cancel()
+	ticker := time.NewTicker(candidatePollInterval)
+	defer ticker.Stop()
+	for {
+		metrics, err := observe(drain)
+		if err != nil {
+			return fmt.Errorf("observe final predecessor pin drain: %w", err)
+		}
+		if metrics.RetiredPins == nil {
+			return errors.New("missing retired pin count after retirement")
+		}
+		credited, err := metrics.Reclamation(predecessor.generation, published.generation)
+		if err != nil {
+			return err
+		}
+		if credited != nil && *metrics.RetiredPins != 0 {
+			return errors.New("reclamation credited before final predecessor pin drain")
+		}
+		info, err := file.Stat()
+		if err != nil {
+			return err
+		}
+		unlinked := info.Sys().(*syscall.Stat_t).Nlink == 0
+		if credited != nil && unlinked {
+			if _, err := data.Lstat(authority.Tail); !errors.Is(err, os.ErrNotExist) {
+				return errors.Join(errors.New("reclaimed predecessor tail path still reachable"), err)
+			}
+			return nil
+		}
+		select {
+		case <-drain.Done():
+			return fmt.Errorf("wait for final predecessor pin drain and tail reclamation: %w", drain.Err())
+		case <-ticker.C:
+		}
+	}
+}
