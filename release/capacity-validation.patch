diff --git a/bench/retained-history/cutover.go b/bench/retained-history/cutover.go
index b964de1..fbee059 100644
--- a/bench/retained-history/cutover.go
+++ b/bench/retained-history/cutover.go
@@ -41,0 +42,19 @@ func validateCutoverFile(path string) (err error) {
+	// Scalar decoding can turn a JSON null counter into zero. Inspect the
+	// raw wire counter separately before accepting a strict report.
+	var raw struct {
+		Cases map[string]struct {
+			Evidence []struct {
+				Diagnostics struct {
+					MemoryEvents map[string]*uint64 `json:"cgroup_memory_events"`
+				} `json:"diagnostics"`
+			} `json:"evidence"`
+		} `json:"cases"`
+	}
+	if err := json.Unmarshal(data, &raw); err != nil {
+		return fmt.Errorf("decode raw capacity counters: %w", err)
+	}
+	for _, record := range raw.Cases[capacityCase].Evidence {
+		if oom := record.Diagnostics.MemoryEvents["oom_kill"]; oom == nil || *oom != 0 {
+			return errors.New("require an observed zero cgroup OOM-kill count")
+		}
+	}
