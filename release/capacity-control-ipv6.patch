+func checkIPv6RetirementAbsent(ctx context.Context, client *http.Client, base string) error {
+	tail := row{TS: fixtureStart, Line: "capacity scope continuation"}
+	if _, err := ingest(ctx, client, base, []row{tail}); err != nil {
+		return err
+	}
+	pager, err := newReleasePager(base, client, 4096)
+	if err != nil {
+		return err
+	}
+	first, _, err := pager.fetch(ctx, "", 1, "")
+	if err != nil {
+		return err
+	}
+	if err := checkBudgetPage(first, []row{{TS: fixtureStart, Line: "capacity scope seed"}}, false, nil); err != nil {
+		return fmt.Errorf("open IPv6 capture: %w", err)
+	}
+	target := base + "/_capacity/compaction?action=retire&cursor=" + url.QueryEscape(first.NextCursor)
+	retired, err := request(ctx, client, http.MethodPost, target, nil)
+	if err != nil {
+		return err
+	}
+	if retired.status != http.StatusNotFound {
+		return fmt.Errorf("IPv6 capture retirement returned HTTP %d, want 404", retired.status)
+	}
+	resumed, _, err := pager.fetch(ctx, "", 1, first.NextCursor)
+	if err != nil {
+		return fmt.Errorf("resume IPv6 capture after hidden retirement: %w", err)
+	}
+	if err := checkBudgetPage(resumed, []row{tail}, true, nil); err != nil {
+		return fmt.Errorf("resume IPv6 capture after hidden retirement: %w", err)
+	}
+	health, err := request(ctx, client, http.MethodGet, base+"/healthz", nil)
+	if err != nil {
+		return err
+	}
+	if health.status != http.StatusOK {
+		return fmt.Errorf("IPv6 health after cursor resume returned HTTP %d, want 200", health.status)
+	}
+	return nil
+}
