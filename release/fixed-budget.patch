+		t.Fatal("accepted close-delimited budget rejection")
+	}
+	response.ContentLength = int64(len(body))
+	if problem := checkBudgetRejection(response, err); problem != nil {
+		t.Fatalf("rejected length-framed budget error: %v", problem)
+	}
+}
