diff --git a/verify/release/cutover_linux_test.go b/verify/release/cutover_linux_test.go
new file mode 100644
index 0000000..b183bfb
--- /dev/null
+++ b/verify/release/cutover_linux_test.go
@@ -0,0 +1,179 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	bogclient "bog/internal/client"
+)
+
+func TestReleaseCursorLifecycle(t *testing.T) {
+	path := os.Getenv("BOG_RELEASE_CURSOR_REPORT")
+	if path == "" {
+		t.Skip("release cursor report path required")
+	}
+	binary := os.Getenv("BOG_RELEASE_BINARY")
+	id, err := readIdentity(binary, os.Getenv("BOG_RELEASE_REVISION"), os.Getenv("BOG_RELEASE_FIXTURE"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(t.Context(), 16*time.Minute)
+	defer cancel()
+	cases := make(map[string]outcome)
+	wire := &http.Client{Timeout: queryDeadline}
+	defer wire.CloseIdleConnections()
+	err = errors.Join(
+		probePagePreparation(ctx, binary, wire, cases),
+		probeAuthenticatedExpiry(ctx, binary, wire, cases),
+	)
+	data, writeErr := json.MarshalIndent(report{id, cases}, "", "  ")
+	if writeErr == nil {
+		writeErr = os.WriteFile(path, append(data, '\n'), 0600)
+	}
+	if err := errors.Join(err, writeErr); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func cleanPageFailure(res response, status int, prefix string) bool {
+	return res.status == status && !res.cursorHeader &&
+		strings.HasPrefix(res.contentType, "text/plain") &&
+		strings.HasPrefix(string(res.body), prefix) && strings.Count(string(res.body), "\n") == 1 &&
+		strings.HasSuffix(string(res.body), "\n")
+}
+
+func probePagePreparation(ctx context.Context, binary string, wire *http.Client, cases map[string]outcome) error {
+	status := 0
+	err := serve(ctx, binary, wire, []string{"-query-max-response-bytes=96"}, func(base string) error {
+		if _, err := ingest(ctx, wire, base, []row{{fixtureStart, "fits"}, {fixtureStart, strings.Repeat("x", 128)}}); err != nil {
+			return err
+		}
+		res, err := request(ctx, wire, http.MethodGet, base+queryPath("", 1, ""), nil)
+		if err != nil {
+			return err
+		}
+		if !cleanPageFailure(res, http.StatusUnprocessableEntity, "query record exceeds response byte limit") {
+			return fmt.Errorf("first-page certification of an oversized later row: HTTP %d, cursor=%t", res.status, res.cursorHeader)
+		}
+		status = res.status
+		return nil
+	})
+	return record(cases, "first_page_preparation", map[string]int{"http_status": status}, err)
+}
+
+func probeAuthenticatedExpiry(ctx context.Context, binary string, wire *http.Client, cases map[string]outcome) error {
+	proof := make(map[string]int)
+	err := serve(ctx, binary, wire, nil, func(base string) error {
+		rows := []row{{fixtureStart, "first"}, {fixtureStart, "last"}}
+		if _, err := ingest(ctx, wire, base, rows); err != nil {
+			return err
+		}
+		client, err := bogclient.New(base, nil)
+		if err != nil {
+			return err
+		}
+		defer client.CloseIdleConnections()
+		start, err := time.Parse(time.RFC3339, fixtureStart)
+		if err != nil {
+			return err
+		}
+		end, err := time.Parse(time.RFC3339, fixtureEnd)
+		if err != nil {
+			return err
+		}
+		q := bogclient.Query{Start: start, End: end, Limit: 1}
+		first, err := client.FetchPage(ctx, q, "")
+		if err != nil {
+			return err
+		}
+		if first.NextCursor == "" || len(first.Rows) != 1 || !first.Rows[0].TS.Equal(start) || first.Rows[0].Line != "first" {
+			return errors.New("expiry fixture did not issue a cursor after the expected first row")
+		}
+		checkLast := func(p bogclient.Page) error {
+			if len(p.Rows) != 1 || !p.Rows[0].TS.Equal(start) || p.Rows[0].Line != "last" || p.NextCursor != "" {
+				return errors.New("wrong terminal page while the cursor was live")
+			}
+			return nil
+		}
+		cursor, err := client.WalkFrom(ctx, q, first.NextCursor, checkLast)
+		if err != nil || cursor != "" {
+			return fmt.Errorf("resume before expiry did not finish: %v", err)
+		}
+		proof["live_terminal_rows"] = 1
+
+		// Change the leading byte to avoid base64 encodings that differ only
+		// in unused trailing bits. The original token remains on its issuer.
+		changed := byte('A')
+		if first.NextCursor[0] == changed {
+			changed = 'B'
+		}
+		res, err := request(ctx, wire, http.MethodGet, base+queryPath(string(changed)+first.NextCursor[1:], 1, ""), nil)
+		if err != nil {
+			return err
+		}
+		if !cleanPageFailure(res, http.StatusBadRequest, "invalid cursor\n") {
+			return fmt.Errorf("tampered continuation: HTTP %d", res.status)
+		}
+		proof["tampered_http_status"] = res.status
+
+		ticker := time.NewTicker(5 * time.Second)
+		defer ticker.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return fmt.Errorf("wait for authenticated cursor expiry: %w", ctx.Err())
+			case <-ticker.C:
+			}
+			res, err := request(ctx, wire, http.MethodGet, base+queryPath(first.NextCursor, 1, ""), nil)
+			if err != nil {
+				return err
+			}
+			if res.status == http.StatusOK {
+				n, err := checkRows(res, rows[1:])
+				if err != nil || n != 1 || res.cursorHeader {
+					return fmt.Errorf("live retry did not reproduce the terminal page: %v", err)
+				}
+				continue
+			}
+			if !cleanPageFailure(res, http.StatusGone, "query capture expired\n") {
+				return fmt.Errorf("authenticated expired continuation: HTTP %d", res.status)
+			}
+			proof["expired_http_status"] = res.status
+			break
+		}
+		delivered := false
+		retry, err := client.WalkFrom(ctx, q, first.NextCursor, func(bogclient.Page) error {
+			delivered = true
+			return nil
+		})
+		var status *bogclient.HTTPError
+		if delivered || retry != first.NextCursor || !errors.As(err, &status) ||
+			status.StatusCode != http.StatusGone || status.Body != "query capture expired\n" || status.Cause != nil {
+			return errors.New("production client did not preserve the failed continuation without delivering rows")
+		}
+		proof["failed_cursor_preserved"] = 1
+		freshRows := 0
+		fresh, err := client.Walk(ctx, q, func(p bogclient.Page) error {
+			for _, got := range p.Rows {
+				if freshRows >= len(rows) || !got.TS.Equal(start) || got.Line != rows[freshRows].Line {
+					return errors.New("wrong row on fresh walk after cursor expiry")
+				}
+				freshRows++
+			}
+			return nil
+		})
+		if err != nil || fresh != "" || freshRows != len(rows) {
+			return fmt.Errorf("fresh walk after expiry did not match %d rows: %v", len(rows), err)
+		}
+		proof["fresh_terminal_rows"] = freshRows
+		return nil
+	})
+	return record(cases, "authenticated_expiry", proof, err)
+}
diff --git a/verify/release/prior_budget.go b/verify/release/prior_budget.go
new file mode 100644
index 0000000..f6a86c5
--- /dev/null
+++ b/verify/release/prior_budget.go
@@ -0,0 +1,135 @@
+package main
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+)
+
+const (
+	fixedBudgetFlag    = "-query-work-budget"
+	fixedBudgetCeiling = 16384
+	fixedBudgetPadding = 4096
+)
+
+type fixedBudgetProof struct {
+	Budget            int  `json:"budget"`
+	RejectedBudget    int  `json:"rejected_budget"`
+	RejectedHTTP      int  `json:"rejected_http_status"`
+	FirstRows         int  `json:"first_rows"`
+	ResumedRows       int  `json:"resumed_rows"`
+	Terminal          bool `json:"terminal"`
+	ContinuationPages int  `json:"continuation_pages"`
+}
+
+// Find the first-page budget boundary over HTTP and finish the walk with
+// the same process and budget at which the first cursor was issued.
+func probeFixedBudget(ctx context.Context, binary string, client *http.Client, rows []row) (proof fixedBudgetProof, err error) {
+	firstPath := queryPath("", 1, "")
+	probe := func(budget int, verify func(string, response) error) error {
+		flags := []string{fmt.Sprintf("%s=%d", fixedBudgetFlag, budget)}
+		return serve(ctx, binary, client, flags, func(base string) error {
+			if _, err := ingest(ctx, client, base, rows); err != nil {
+				return err
+			}
+			res, err := request(ctx, client, http.MethodGet, base+firstPath, nil)
+			if err != nil {
+				return err
+			}
+			return verify(base, res)
+		})
+	}
+	rejected := func(res response) bool {
+		return res.status == http.StatusServiceUnavailable && !res.cursorHeader &&
+			strings.HasPrefix(res.contentType, "text/plain") &&
+			string(res.body) == "query work budget exhausted\n"
+	}
+	requireRow := func(res response, want row) error {
+		n, err := checkRows(res, []row{want})
+		if err != nil {
+			return err
+		}
+		if n != 1 || res.body[len(res.body)-1] != '\n' {
+			return errors.New("expected one complete NDJSON row")
+		}
+		return nil
+	}
+	requireFirst := func(res response) error {
+		if err := requireRow(res, rows[0]); err != nil {
+			return err
+		}
+		if !res.cursorHeader || res.cursor == "" {
+			return errors.New("first page omitted its continuation")
+		}
+		return nil
+	}
+	low, high := 1, fixedBudgetCeiling
+	for low+1 < high {
+		mid := low + (high-low)/2
+		if err := probe(mid, func(_ string, res response) error {
+			if rejected(res) {
+				low = mid
+				return nil
+			}
+			if err := requireFirst(res); err != nil {
+				return err
+			}
+			high = mid
+			return nil
+		}); err != nil {
+			return proof, fmt.Errorf("measure first page at budget %d: %w", mid, err)
+		}
+	}
+	proof.Budget, proof.RejectedBudget = high, low
+	if err := probe(low, func(base string, res response) error {
+		proof.RejectedHTTP = res.status
+		if !rejected(res) {
+			return fmt.Errorf("expected a clean budget rejection, got HTTP %d: %.200s", res.status, res.body)
+		}
+		if len(rows) != 2 {
+			return nil
+		}
+		// A short ordinary query still fits. The paged request has to
+		// reserve the more expensive next response before it can succeed.
+		ordinary, err := request(ctx, client, http.MethodGet, base+strings.Replace(firstPath, "&page=1", "", 1), nil)
+		if err != nil {
+			return err
+		}
+		return requireRow(ordinary, rows[0])
+	}); err != nil {
+		return proof, fmt.Errorf("one below measured budget %d: %w", high, err)
+	}
+	err = probe(high, func(base string, first response) error {
+		if err := requireFirst(first); err != nil {
+			return err
+		}
+		proof.FirstRows = 1
+		seen := map[string]bool{first.cursor: true}
+		cursor := first.cursor
+		for i, want := range rows[1:] {
+			res, err := request(ctx, client, http.MethodGet, base+queryPath(cursor, 1, ""), nil)
+			if err != nil {
+				return err
+			}
+			if err := requireRow(res, want); err != nil {
+				return fmt.Errorf("continuation %d: %w", i+1, err)
+			}
+			more := i+2 < len(rows)
+			if res.cursorHeader != more || (more && (res.cursor == "" || seen[res.cursor])) {
+				return fmt.Errorf("continuation %d: expected a fresh cursor=%t", i+1, more)
+			}
+			seen[res.cursor] = true
+			cursor = res.cursor
+			proof.ContinuationPages++
+			proof.ResumedRows++
+			proof.Terminal = !more
+		}
+		return nil
+	})
+	if err != nil {
+		err = fmt.Errorf("resume at measured budget %d: %w", high, err)
+	}
+	return proof, err
+}
