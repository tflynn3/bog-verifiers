@@ -353 +358 @@
-	walk, walkErr := probeBudgetWalk(ctx, binary, client)
+	walk, walkErr := probeBudgetWalk(ctx, binary, client, certifiedPaging)
@@ -356,0 +362,18 @@
+}
+
+// The certification runtime introduced a specific invalid-limit diagnostic.
+// Probe it independently of continuation success so a broken walk fails the gate.
+func supportsCertifiedPaging(ctx context.Context, client *http.Client, base string) (bool, error) {
+	res, err := request(ctx, client, http.MethodGet, base+queryPath("", 0, ""), nil)
+	if err != nil {
+		return false, fmt.Errorf("detect paging certification: %w", err)
+	}
+	if res.status == http.StatusBadRequest && !res.cursorHeader {
+		switch string(res.body) {
+		case "invalid limit\n":
+			return true, nil
+		case "invalid query\n":
+			return false, nil
+		}
+	}
+	return false, fmt.Errorf("unexpected paging capability response: HTTP %d, %.200q", res.status, res.body)
